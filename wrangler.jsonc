{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-long-silence",
  "compatibility_date": "2026-07-25",

  // 纯静态资产 Worker：没有服务端代码，因此没有 "main" 入口。
  // Vite 将整个游戏输出到 dist/，包括 public/ 中的一切（图标、清单、分享图）。
  "assets": {
    "directory": "./dist"
  },

  // custom_domain 让 Cloudflare 自行创建并管理该主机名的 DNS 记录，
  // 而无需单独的记录 + 路由。
  "routes": [
    { "pattern": "longsilence.anshu.dev", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
